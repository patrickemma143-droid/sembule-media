# Sembule Media: rules for the new static site on Hostinger (LiteSpeed / Apache).
# This file keeps Google's index when sembulemedia.com moves from the old WordPress site to this one:
# every old address answers with a permanent (301) redirect to the page that replaces it.
# Keep these redirects for at least a year after launch.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. One address for the whole site: https://sembulemedia.com (no www, always https)
RewriteCond %{HTTP_HOST} ^www\.sembulemedia\.com$ [NC]
RewriteRule ^(.*)$ https://sembulemedia.com/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^sembulemedia\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://sembulemedia.com/$1 [R=301,L]

# 2. Old WordPress pages to the new pages
RewriteRule ^(home|home-2)/?$ / [R=301,L,NC]
RewriteRule ^about(-us)?/?$ /about.html [R=301,L,NC]
RewriteRule ^(team|our-team)/?$ /about.html [R=301,L,NC]
RewriteRule ^contact(-us)?/?$ /contact.html [R=301,L,NC]
RewriteRule ^services?/?$ /services.html [R=301,L,NC]
RewriteRule ^(portfolio|gallery|work)/?$ /portfolio.html [R=301,L,NC]
RewriteRule ^bwg_gallery(/.*)?$ /portfolio.html [R=301,L,NC]
RewriteRule ^bwg_(share|album|tag)(/.*)?$ /portfolio.html [R=301,L,NC]
RewriteRule ^privacy(-policy)?/?$ /privacy.html [R=301,L,NC]
RewriteRule ^terms(-and-conditions|-of-service)?/?$ /terms.html [R=301,L,NC]
RewriteRule ^(sample-page|blog)/?$ / [R=301,L,NC]
RewriteRule ^[0-9]{4}/[0-9]{2}(/.*)?$ / [R=301,L]
RewriteRule ^(category|tag|author)(/.*)?$ / [R=301,L,NC]
RewriteRule ^(comments/)?feed/?$ / [R=301,L,NC]
RewriteRule ^.+/feed/?$ / [R=301,L,NC]

# Old sitemaps (Yoast / All in One SEO / WordPress core) to the new one
RewriteRule ^(sitemap_index|wp-sitemap|[a-z_-]+-sitemap[0-9]*)\.xml$ /sitemap.xml [R=301,L,NC]
RewriteRule ^sitemap\.xsl$ /sitemap.xml [R=301,L,NC]

# WordPress query addresses (?p=12, ?page_id=5, ?cat=1, ?s=...) to the home page, query dropped
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|tag|s|attachment_id|m)= [NC]
RewriteRule ^(index\.php)?$ /? [R=301,L]
RewriteRule ^index\.php$ / [R=301,L,NC]

# 3. WordPress system files no longer exist: tell search engines they are gone (410)
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/.*)?$ - [G,L,NC]
RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-signup|wp-trackback)\.php$ - [G,L,NC]
</IfModule>

# 4. Only sembulemedia.com may be indexed. The Hostinger preview address (and any other host
#    name pointing at these files) is marked noindex, so Google never lists a duplicate site.
<IfModule mod_headers.c>
SetEnvIfNoCase Host ^(www\.)?sembulemedia\.com$ SM_LIVE
Header set X-Robots-Tag "noindex, nofollow" env=!SM_LIVE
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Caching: pages revalidate, styles and scripts for a week, media for a month
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
ExpiresByType text/javascript "access plus 1 week"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType video/mp4 "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

AddType font/woff2 .woff2
AddType video/mp4 .mp4
